{
  "name": "@avs/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --local --var APP_ENV:development --var AI_TEXT_PROVIDER:none --var AI_MEDIA_PROVIDER:none",
    "deploy": "bash ../../scripts/validate-env.sh && wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "cf:create": "wrangler d1 create ai-video-studio && wrangler r2 bucket create ai-video-studio-media",
    "types": "wrangler types --check",
    "dev:ai": "wrangler dev --var APP_ENV:development"
  },
  "dependencies": {
    "@avs/contracts": "workspace:*",
    "@avs/schemas": "workspace:*",
    "@avs/types": "workspace:*",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.8.1"
  }
}
