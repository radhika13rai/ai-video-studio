{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "ai-video-studio",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",

  // The built frontend is served by the same Worker; /api/* always reaches the Worker first.
  // Run `pnpm build` once before `wrangler dev` or `wrangler deploy` so this directory exists.
  "assets": {
    "directory": "../../apps/studio/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },

  "observability": { "enabled": true },

  // Local development (`wrangler dev`) simulates D1 and R2 on disk under .wrangler/state.
  // The id below is the real D1 database created on Cloudflare (not a secret).
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ai-video-studio",
      "database_id": "3d2f33ab-7281-43d0-8427-2874e2dcc981",
      "migrations_dir": "migrations",
    },
  ],

  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "ai-video-studio-media",
    },
  ],

  // Workers AI (free daily allowance). Always runs on Cloudflare, even under `wrangler dev`, so it
  // needs a logged-in account; tests use a scripted fake model instead.
  "ai": { "binding": "AI" },

  "workflows": [
    {
      "name": "production-workflow",
      "binding": "PRODUCTION_WORKFLOW",
      "class_name": "ProductionWorkflow",
    },
  ],

  // APP_ENV defaults to production so a deploy fails closed: without ACCESS_TEAM_DOMAIN and
  // ACCESS_AUD every API call except /health is rejected. `pnpm dev` overrides it to development.
  "vars": {
    "APP_ENV": "production",
    "ACCESS_TEAM_DOMAIN": "",
    "ACCESS_AUD": "",
    "AI_TEXT_PROVIDER": "workers-ai",
    "MAX_VIDEO_DURATION": "60",
    "MAX_PROJECT_SCENES": "20",
  },
}
